{
  "$comment": "A repository at a fixed commit with known vulnerabilities.",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "repo": { "type": "string", "description": "clone URL or local path" },
    "commit": { "type": "string" },
    "embargoed": {
      "type": "boolean",
      "description": "true while any expected finding is not publicly fixed; such files must live in benchmarks/private/"
    },
    "expected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "bug_class": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "locations": { "type": "array", "items": { "type": "string" }, "description": "file:line, relative to the repository root" }
        },
        "required": ["id", "title", "bug_class", "severity", "locations"]
      }
    }
  },
  "required": ["name", "repo", "commit", "embargoed", "expected"]
}
